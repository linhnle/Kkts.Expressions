<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Copyright>Copyright (C) 2016-2026 KKTS Ltd.</Copyright>
    <Version>3.1.0</Version>
    <Authors>Linh Le</Authors>
    <Product>Dynamic Expression</Product>
    <Company>KKTS Ltd.</Company>
    <PackageProjectUrl>https://github.com/linhnle/Kkts.Expressions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/linhnle/Kkts.Expressions.git</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Translate Kkts.Expressions predicates, ordering, and pagination into OpenSearch Query DSL JSON without an OpenSearch client dependency.</Description>
    <PackageTags>expression;linq;expression-tree;dynamic-filter;opensearch;query-dsl;search;filtering;sorting;pagination</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kkts.Expressions\Kkts.Expressions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kkts.Expressions.OpenSearch.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
